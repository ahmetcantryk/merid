{
  "name": "@meridui/cli",
  "version": "0.1.1",
  "description": "Set up the Merid React component library in Next.js, Vite or React Router: install, stylesheet, template CSS cleanup, AI rules, MCP config and page patterns.",
  "keywords": [
    "merid",
    "cli",
    "scaffold",
    "setup",
    "init",
    "react",
    "component-library",
    "design-system",
    "nextjs",
    "vite",
    "react-router",
    "tailwindcss",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents-md",
    "cursor",
    "claude-code"
  ],
  "homepage": "https://meridui.dev/docs/cli",
  "bugs": {
    "url": "https://github.com/ahmetcantryk/merid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetcantryk/merid.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Ahmet Can Tiryaki",
  "type": "module",
  "bin": {
    "merid": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-data.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint src test",
    "publint": "publint"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
