{
  "name": "@meridui/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Merid React component library. Gives Claude Code, Cursor and VS Code the real components, props, tokens and setup guides. Read-only and offline.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "ai-agents",
    "llm",
    "claude",
    "claude-code",
    "cursor",
    "vscode",
    "windsurf",
    "llms-txt",
    "react",
    "component-library",
    "design-system",
    "design-tokens",
    "documentation",
    "merid"
  ],
  "homepage": "https://meridui.dev/docs/ai",
  "bugs": {
    "url": "https://github.com/ahmetcantryk/merid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetcantryk/merid.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "author": "Ahmet Can Tiryaki",
  "type": "module",
  "bin": {
    "merid-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-data.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint src test",
    "publint": "publint"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^26.6.3",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
