{
  "name": "merid-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @merid/react && npm run build -w merid-docs",
    "dev": "npm run dev -w merid-docs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c e2e a11y interactions playground",
    "test:visual": "playwright test -c e2e visual --project=chromium",
    "test:ssr": "npm run test -w @merid/react -- test/ssr",
    "test:compat": "npm run build -w @merid/react && npm ci --prefix tests/compat-react18 --no-audit --no-fund && npm test --prefix tests/compat-react18",
    "test:consumers": "npm run build -w @merid/react && node tests/consumers/run.mjs",
    "test:coverage": "npm run test -w @merid/react -- --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript-eslint": "^8.70.1"
  }
}
